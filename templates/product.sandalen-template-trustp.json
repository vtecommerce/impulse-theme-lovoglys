    "ss_feature_1_496aBd": {
      "type": "ss-feature-1",
      "blocks": {
        "image_JmhBNx": {
          "type": "image",
          "settings": {
            "feature_title": "GRATIS FORSENDELSE",
            "feature_text": "<p>Nyd altid gratis forsendelse på alle dine ordrer, uden minimumsbeløb. Din pakke pakkes omhyggeligt og sendes via <strong>PostNord</strong> med en <strong>Track & Trace-kode</strong>, så du ved præcis, hvornår din ordre ankommer. Vores premium-service sikrer pålidelig levering.</p>",
            "feature_url": "",
            "hide_image": false
          }
        },
        "image_f7xdNE": {
          "type": "image",
          "settings": {
            "feature_title": "30 DAGES RETURRET",
            "feature_text": "<p>Ikke helt tilfreds? Intet problem. Hos os kan du nemt returnere varer inden for 30 dage efter modtagelsen. Vi sørger for en hurtig og gennemsigtig returproces, så du kan shoppe uden bekymringer. Din tilfredshed er vores højeste prioritet.</p>",
            "feature_url": "",
            "hide_image": false
          }
        },
        "image_Thz8bj": {
          "type": "image",
          "settings": {
            "feature_title": "SIKKER BETALING",
            "feature_text": "<p>Betal sikkert, hurtigt og trygt med den betalingsmetode, du foretrækker. Vi understøtter blandt andet <strong>KreditKort</strong>, <strong>MobilePay</strong>, <strong>Apple Pay, Google Pay og VISA</strong>. Alle vores betalinger foregår via sikre forbindelser, så dine oplysninger er fuldt beskyttet.</p>",
            "feature_url": "",
            "hide_image": false
          }
        }
      },
